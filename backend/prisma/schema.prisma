// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  client
  organizer
  admin
}

enum EventCategory {
  theatre
  cinema
  concert
  conference
}

enum EventStatus {
  draft
  active
  cancelled
  completed
}

enum SeatStatus {
  free
  blocked
  group_blocked
  sold
}

enum BookingStatus {
  pending
  paid
  cancelled
  expired
  refunded
}

enum PaymentMethod {
  card
  wallet
  sbp
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum GroupSessionStatus {
  active
  completed
  expired
  cancelled
}

enum NotificationType {
  email
  push
}

enum DeliveryStatus {
  pending
  sent
  failed
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid @map("user_id")
  email                  String                   @unique @db.VarChar(255)
  passwordHash           String                   @map("password_hash") @db.VarChar(255)
  firstName              String                   @map("first_name") @db.VarChar(100)
  lastName               String                   @map("last_name") @db.VarChar(100)
  phone                  String?                  @db.VarChar(20)
  dateOfBirth            DateTime?                @map("date_of_birth")
  role                   UserRole                 @default(client)
  isVerified             Boolean                  @default(false) @map("is_verified")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  organizerProfile       Organizer?
  adminProfile           Admin?
  bookings               Booking[]
  groupSessionsAsLeader  GroupSession[]           @relation("GroupLeader")
  notifications          Notification[]
  refreshTokens          RefreshToken[]
  resetPasswordTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Organizer {
  id          String   @id @default(uuid()) @db.Uuid @map("organizer_id")
  userId      String   @unique @db.Uuid @map("user_id")
  companyName String?  @map("company_name") @db.VarChar(255)
  verified    Boolean  @default(false)
  verifiedAt  DateTime? @map("verified_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]

  @@map("organizers")
}

model Admin {
  id        String   @id @default(uuid()) @db.Uuid @map("admin_id")
  userId    String   @unique @db.Uuid @map("user_id")
  department String? @db.VarChar(100)
  lastLogin DateTime? @map("last_login")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Venue {
  id          String  @id @default(uuid()) @db.Uuid @map("venue_id")
  name        String  @db.VarChar(255)
  address     String  @db.VarChar(500)
  city        String  @db.VarChar(100)
  totalRows   Int     @map("total_rows")
  seatsPerRow Int     @map("seats_per_row")
  events      Event[]

  @@map("venues")
}

model Event {
  id          String        @id @default(uuid()) @db.Uuid @map("event_id")
  organizerId String?       @db.Uuid @map("organizer_id")
  venueId     String?       @db.Uuid @map("venue_id")
  title       String        @db.VarChar(255)
  description String
  category    EventCategory
  dateTime    DateTime      @map("date_time")
  duration    Int
  venue       String        @db.VarChar(255)
  address     String        @db.VarChar(500)
  city        String?       @db.VarChar(100)
  minAge      Int           @default(0) @map("min_age")
  posterUrl   String?       @map("poster_url") @db.VarChar(500)
  status      EventStatus   @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  organizer   Organizer?    @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  venueEntity Venue?        @relation(fields: [venueId], references: [id], onDelete: SetNull)
  seats       Seat[]
  bookings    Booking[]
  groupSessions GroupSession[]

  @@index([category, dateTime], map: "idx_events_category_datetime")
  @@index([city], map: "idx_events_city")
  @@map("events")
}

model GroupSession {
  id                String             @id @default(uuid()) @db.Uuid @map("session_id")
  leaderId          String             @db.Uuid @map("leader_id")
  eventId           String             @db.Uuid @map("event_id")
  inviteLink        String             @unique @map("invite_link") @db.VarChar(500)
  totalSeats        Int                @map("total_seats")
  participantsCount Int                @default(0) @map("participants_count")
  status            GroupSessionStatus @default(active)
  createdAt         DateTime           @default(now()) @map("created_at")
  expiresAt         DateTime           @map("expires_at")
  leader            User               @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats             Seat[]
  bookings          Booking[]

  @@index([eventId], map: "idx_group_sessions_event_id")
  @@map("group_sessions")
}

model Seat {
  id             String       @id @default(uuid()) @db.Uuid @map("seat_id")
  eventId        String       @db.Uuid @map("event_id")
  rowNumber      Int          @map("row_number")
  seatNumber     Int          @map("seat_number")
  sector         String?      @db.VarChar(50)
  price          Decimal      @db.Decimal(10, 2)
  status         SeatStatus   @default(free)
  lockedUntil    DateTime?    @map("locked_until")
  groupSessionId String?      @db.Uuid @map("group_session_id")
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groupSession   GroupSession? @relation(fields: [groupSessionId], references: [id], onDelete: SetNull)
  bookingItems   BookingItem[]

  @@unique([eventId, rowNumber, seatNumber], map: "uq_seat_event_row_number")
  @@index([status, lockedUntil], map: "idx_seats_status_locked_until")
  @@map("seats")
}

model Booking {
  id             String        @id @default(uuid()) @db.Uuid @map("booking_id")
  userId         String        @db.Uuid @map("user_id")
  eventId        String        @db.Uuid @map("event_id")
  groupSessionId String?       @db.Uuid @map("group_session_id")
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  status         BookingStatus @default(pending)
  createdAt      DateTime      @default(now()) @map("created_at")
  expiresAt      DateTime      @map("expires_at")
  paidAt         DateTime?     @map("paid_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  groupSession   GroupSession? @relation(fields: [groupSessionId], references: [id], onDelete: SetNull)
  items          BookingItem[]
  payment        Payment?

  @@index([userId, createdAt], map: "idx_bookings_user_created_at")
  @@index([eventId, status], map: "idx_bookings_event_status")
  @@map("bookings")
}

model BookingItem {
  id             String   @id @default(uuid()) @db.Uuid @map("booking_item_id")
  bookingId      String   @db.Uuid @map("booking_id")
  seatId         String   @db.Uuid @map("seat_id")
  priceAtBooking Decimal  @map("price_at_booking") @db.Decimal(10, 2)
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat           Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)
  ticket         Ticket?

  @@unique([bookingId, seatId], map: "uq_booking_item_booking_seat")
  @@map("booking_items")
}

model Ticket {
  id            String      @id @default(uuid()) @db.Uuid @map("ticket_id")
  bookingItemId String      @unique @db.Uuid @map("booking_item_id")
  qrCode        String      @unique @map("qr_code") @db.VarChar(500)
  pdfUrl        String?     @map("pdf_url") @db.VarChar(500)
  issuedAt      DateTime    @default(now()) @map("issued_at")
  isUsed        Boolean     @default(false) @map("is_used")
  usedAt        DateTime?   @map("used_at")
  bookingItem   BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid @map("payment_id")
  bookingId     String        @unique @db.Uuid @map("booking_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  transactionId String?       @map("transaction_id") @db.VarChar(255)
  status        PaymentStatus @default(pending)
  createdAt     DateTime      @default(now()) @map("created_at")
  processedAt   DateTime?     @map("processed_at")
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id        String         @id @default(uuid()) @db.Uuid @map("notification_id")
  userId    String         @db.Uuid @map("user_id")
  type      NotificationType
  subject   String         @db.VarChar(255)
  content   String
  sentAt    DateTime?      @map("sent_at")
  status    DeliveryStatus @default(pending)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_email_verification_tokens_user_id")
  @@map("email_verification_tokens")
}
